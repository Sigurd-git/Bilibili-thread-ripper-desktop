{
  "name": "btr-desktop",
  "private": true,
  "version": "2026.9.29.1-d2",
  "description": "BTR desktop adapter for the official Bilibili macOS and Windows clients",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs && node tools/build-launcher.cjs",
    "release": "npm run build && node tools/package-release.cjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node test/browser.cjs",
    "test:native": "node --test test/macos-native.test.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
